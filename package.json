{
  "name": "personal-job-tracker-app",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/check-private.cjs && node scripts/check-data.cjs && node --test tests/*.test.cjs && node tests/browser.cjs && node tests/workspace-browser.cjs",
    "start": "node scripts/serve.cjs --strict-port",
    "build": "node scripts/build.cjs",
    "check:data": "node scripts/check-data.cjs",
    "start:local": "node scripts/manage.cjs start",
    "restart:local": "node scripts/manage.cjs restart",
    "stop:local": "node scripts/manage.cjs stop",
    "update:local": "node scripts/update.cjs",
    "check:private": "node scripts/check-private.cjs",
    "import:mail": "node scripts/import-mail.cjs",
    "mark": "node scripts/mark.cjs",
    "match:resume": "node scripts/match-resume.cjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
